<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier. Photos and their WebView metadata are deliberately
     device-only, so no app-owned domain is eligible for cloud backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
