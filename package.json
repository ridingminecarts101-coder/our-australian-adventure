{
  "name": "wayfinder",
  "version": "1.0.0",
  "private": true,
  "description": "Wayfinder - real places worth going, ticked off together.",
  "scripts": {
    "build:data": "python tools/build_data.py",
    "build:icons": "python tools/build_icons.py",
    "stage": "node tools/stage.mjs",
    "check": "python tools/check_all.py",
    "serve": "python -m http.server 8811 --bind 127.0.0.1",
    "sync": "npm run stage && npx cap sync",
    "android:aab": "npm run stage && npx cap copy android && cd android && gradlew.bat bundleRelease",
    "android:apk": "npm run stage && npx cap copy android && cd android && gradlew.bat assembleRelease",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "release": "python tools/release.py build",
    "release:show": "python tools/release.py show",
    "play": "python tools/play.py",
    "play:doctor": "python tools/play.py doctor",
    "play:status": "python tools/play.py status"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@electric-sql/pglite": "^0.5.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@revenuecat/purchases-capacitor": "^13.5.0"
  }
}
